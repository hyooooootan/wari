{
  "name": "wari",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public",
    "dev:cloudflare": "wrangler pages dev public",
    "dev:static": "python server.py",
    "db:local": "wrangler d1 execute wari-db --local --file=./db/schema.sql",
    "db:remote": "wrangler d1 execute wari-db --remote --file=./db/schema.sql",
    "d1:create": "wrangler d1 create wari-db",
    "d1:migrate:local": "wrangler d1 execute wari-db --local --file=./db/schema.sql",
    "d1:migrate:remote": "wrangler d1 execute wari-db --remote --file=./db/schema.sql",
    "ocr:dev": "python -m services.receipt_ocr.api",
    "deploy": "wrangler pages deploy public --project-name=wari"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
