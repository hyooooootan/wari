# Public application origin. Used for CSRF validation and callback fallback.
APP_ORIGIN=https://example.invalid

# Google login OAuth callback. Leave empty to derive it from APP_ORIGIN.
OAUTH_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail connection OAuth. The same Google Cloud client may be used only when
# both callback URIs are registered and the intended consent configuration is approved.
GMAIL_REDIRECT_URI=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Base64-encoded AES-256 key material and the active key generation number.
GMAIL_TOKEN_KEY_CURRENT_GENERATION=1
GMAIL_TOKEN_KEY_V1=

# Administrative revocation retry endpoint. Configure as a Cloudflare Secret.
GMAIL_REVOCATION_RETRY_SECRET=

# Local test mock. Never configure this in production.
OAUTH_MOCK_USER_JSON=

# Optional OCR configuration.
OCR_BACKEND=auto
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-5.4-mini
RECEIPT_OCR_API_URL=
OCR_API_URL=
RECEIPT_OCR_SHARED_SECRET=
OCR_MAX_IMAGE_BYTES=
OCR_TIMEOUT_MS=60000
RECEIPT_OCR_ENABLE_FEEDBACK_READ=false
RECEIPT_OCR_ENABLE_FEEDBACK_WRITE=false
OCR_FEEDBACK_TOKEN_KEY_V1=
