[Unit]
Description=Wari Receipt OCR API
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wari
EnvironmentFile=-/etc/wari-receipt-ocr.env
Environment=OCR_BACKEND=tesseract_ollama
Environment=OCR_HOST=127.0.0.1
Environment=PORT=4190
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=qwen2.5:3b
Environment=TESSERACT_LANG=jpn+eng
Environment=TESSERACT_TIMEOUT=20
Environment=TESSERACT_MAX_SIDE=1800
Environment=OMP_THREAD_LIMIT=2
ExecStart=/opt/wari/services/receipt_ocr/.venv/bin/python -m services.receipt_ocr.api
Restart=on-failure
RestartSec=5
User=opc
Group=opc

[Install]
WantedBy=multi-user.target
